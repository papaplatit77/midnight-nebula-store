# ══════════════════════════════════════════════════════════════
# Эти переменные вставляются в Vercel → Settings → Environment Variables
# ══════════════════════════════════════════════════════════════

# ── Telegram (для /api/order) ──────────────────────────────────
# Токен бота (тот же что и в bot/.env)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram user ID (тот же что ADMIN_CHAT_ID в боте)
TELEGRAM_ADMIN_CHAT_ID=123456789

# ── Бот на Railway ────────────────────────────────────────────
# URL Railway приложения (формат: https://xxx.up.railway.app)
BOT_API_URL=https://ВАШ_БОТ.up.railway.app

# ── Безопасность ──────────────────────────────────────────────
# Пароль для входа в /admin (придумайте сложный)
ADMIN_PASSWORD=ВашСложныйПароль123!

# Секрет для связи Vercel → Bot (тот же что ADMIN_SECRET в боте)
ADMIN_SECRET=замените_на_случайную_строку_минимум_32_символа
