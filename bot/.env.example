# ── Telegram ──────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Твой Telegram user ID (узнать через @userinfobot)
ADMIN_CHAT_ID=123456789

# Дополнительные admin ID через запятую (необязательно)
EXTRA_ADMINS=

# Username поддержки без @ (необязательно)
SUPPORT_USERNAME=wakashop_support

# ── Сайт ──────────────────────────────────────────────────────
# URL сайта на Vercel (для кнопки Mini App)
WEBAPP_URL=https://ВАШ_ПРОЕКТ.vercel.app

# ── Безопасность ──────────────────────────────────────────────
# Секрет для связи Vercel → Bot (случайная строка 32+ символа)
ADMIN_SECRET=замените_на_случайную_строку_минимум_32_символа

# ── Сервер ────────────────────────────────────────────────────
PORT=3001

# Курьеры по городам (JSON-строка)
# Поля: city (обязательно), username (Telegram), name, phone, note
# Пример:
# COURIERS_JSON=[{"city":"Кёльн","username":"@courier1","name":"Алекс"},{"city":"Дюссельдорф","username":"@courier2","name":"Макс","note":"Работает с 12:00 до 22:00"}]
COURIERS_JSON=[]
