# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# Chat ID администратора (получить через @userinfobot)
ADMIN_CHAT_ID=your_admin_chat_id_here

# URL вашего сайта (мини-апп) — после деплоя
WEBAPP_URL=https://your-site.com

# Порт для Express сервера
PORT=3001

# Курьеры по городам (JSON-строка)
# Поля: city (обязательно), username (Telegram), name, phone, note
# Пример:
# COURIERS_JSON=[{"city":"Кёльн","username":"@courier1","name":"Алекс"},{"city":"Дюссельдорф","username":"@courier2","name":"Макс","note":"Работает с 12:00 до 22:00"}]
COURIERS_JSON=[]
